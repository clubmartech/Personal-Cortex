{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/cortex/bin/cortex.py\" context --project \"${CLAUDE_PROJECT_DIR:-$PWD}\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/cortex/bin/atos.py\" contexto --project \"${CLAUDE_PROJECT_DIR:-$PWD}\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/cortex/bin/atos.py\" hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/cortex/bin/cortex.py\" maintain --quiet"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/cortex/bin/atos.py\" destilar --quiet"
          }
        ]
      }
    ]
  }
}
